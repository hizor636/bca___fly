{
  "name": "bcafly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx server/index.ts",
    "server:gateway": "npm run dev --prefix services/gateway-ts",
    "server:python": "uvicorn main:app --app-dir services/analytics-python --reload --port 8000",
    "server:java": "mvn -f services/core-java/pom.xml spring-boot:run",
    "server:ai": "python server/python/analytics_service.py",
    "dev:all": "concurrently -k \"npm run server\" \"npm run server:ai\" \"npm run dev\"",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "sql": "tsx server/db/cli.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },

  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
